{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skinroom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Daily at 14:00 UTC (10am Eastern) — check-in reminder emails.
  "triggers": { "crons": ["0 14 * * *"] },
  "observability": { "enabled": true }
  // Secrets are added with `npx wrangler secret put NAME` (see SETUP.md), never written here.
}
